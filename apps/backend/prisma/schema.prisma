generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bomlist {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sn_carton        String?      @db.VarChar(255)
  pcb_idu          String?      @db.VarChar(255)
  sn_box           String?      @db.VarChar(255)
  sn_motor         String?      @db.VarChar(255)
  sn_accessories   String?      @db.VarChar(255)
  order_number     String?      @db.VarChar(255)
  sn               String?      @db.VarChar(255)
  timestamps       DateTime?    @default(now()) @db.Timestamp(6)
  model            String?      @db.VarChar(255)
  product_category String?      @db.VarChar(50)
  // Legacy JSONB columns are retained only during the data-migration window.
  // New category-aware writes use ac_bom_spec or wm_bom_spec instead.
  components       Json?        @db.JsonB
  unit_map         Json?        @db.JsonB
  is_active        Boolean      @default(true)
  ac_spec          ac_bom_spec?
  wm_spec          wm_bom_spec?
}

model recordscan {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_regist        String?   @db.VarChar(255)
  sn_carton        String?   @db.VarChar(255)
  pcb_idu          String?   @db.VarChar(255)
  sn_box           String?   @db.VarChar(255)
  sn_motor         String?   @db.VarChar(255)
  sn_accessories   String?   @db.VarChar(255)
  sn               String?   @db.VarChar(255)
  sn_odu           String?   @db.VarChar(255)
  timestamps       DateTime? @default(now()) @db.Timestamptz(6)
  product_category String?   @db.VarChar(50)
  components       Json?     @db.JsonB

  @@index([id_regist(ops: raw("gin_trgm_ops"))], map: "idx_recordscan_id_regist_trgm", type: Gin)
  @@index([pcb_idu], map: "idx_recordscan_pcb_idu")
  @@index([sn], map: "idx_recordscan_sn")
  @@index([sn_accessories], map: "idx_recordscan_sn_accessories")
  @@index([sn_box], map: "idx_recordscan_sn_box")
  @@index([sn_carton], map: "idx_recordscan_sn_carton")
  @@index([sn_motor], map: "idx_recordscan_sn_motor")
  @@index([timestamps], map: "idx_recordscan_timestamps")
}

model registscan {
  timestamps       DateTime?             @default(now()) @db.Timestamptz(6)
  model            String                @db.VarChar(255)
  order_number     String                @db.VarChar(255)
  subline          String                @db.VarChar(255)
  userid           String                @db.VarChar(255)
  shift            String?               @db.VarChar(255)
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sn               String?               @db.VarChar
  sn_carton        String?               @db.VarChar
  pcb_idu          String?               @db.VarChar
  sn_box           String?               @db.VarChar
  sn_motor         String?               @db.VarChar
  sn_accessories   String?               @db.VarChar
  sn_odu           String?               @db.VarChar
  plan             Int?
  po_number        String?               @db.VarChar(255)
  product_category String?               @db.VarChar(50)
  // Legacy columns retained for backwards-compatible reads during cutover.
  components       Json?                 @db.JsonB
  fields_snapshot  Json?                 @db.JsonB
  ac_spec          ac_registration_spec?
  wm_spec          wm_registration_spec?
  ac_scans         recordscan_ac[]
  wm_scans         recordscan_wm[]
}

model line {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line               String? @db.VarChar(255)
  uph_uph_lineToline uph[]   @relation("uph_lineToline")
}

model model {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand                String?             @db.VarChar(255)
  model                String?             @db.VarChar(255)
  pk                   Decimal?            @db.Decimal
  linkimage            String?             @db.VarChar(255)
  product              String?             @db.VarChar
  category_id          String?             @db.Uuid
  category             product_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  uph_uph_modelTomodel uph[]               @relation("uph_modelTomodel")
}

model uph {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model                  String? @db.Uuid
  line                   String? @db.Uuid
  uph                    Int?
  line_uph_lineToline    line?   @relation("uph_lineToline", fields: [line], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_uph_modelTomodel model?  @relation("uph_modelTomodel", fields: [model], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  username    String  @db.VarChar(255)
  hash        String  @db.VarChar(255)
  password    String? @db.VarChar(255)
  email       String  @db.VarChar(255)
  roleuser    String  @db.VarChar(255)
  departement String  @db.VarChar(255)
  section     String? @db.VarChar(255)
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

model pin {
  id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pin  Int?
  date DateTime? @default(now()) @db.Date
}

model product_categories {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String    @unique @db.VarChar(50)
  name       String    @db.VarChar(100)
  fields     Json?     @db.JsonB
  created_at DateTime? @default(now()) @db.Timestamp(6)
  model      model[]
}

// AC BOM values and field settings. Each BOM has at most one AC specification.
model ac_bom_spec {
  bom_id                  String  @id @db.Uuid
  sn_prefix               String?
  sn_required             Boolean @default(true)
  sn_unit                 String? @db.VarChar(3)
  sn_odu_prefix           String?
  sn_odu_required         Boolean @default(false)
  sn_odu_unit             String? @db.VarChar(3)
  sn_carton_prefix        String?
  sn_carton_required      Boolean @default(false)
  sn_carton_unit          String? @db.VarChar(3)
  pcb_idu_prefix          String?
  pcb_idu_required        Boolean @default(false)
  pcb_idu_unit            String? @db.VarChar(3)
  pcb_odu_prefix          String?
  pcb_odu_required        Boolean @default(false)
  pcb_odu_unit            String? @db.VarChar(3)
  sn_box_prefix           String?
  sn_box_required         Boolean @default(false)
  sn_box_unit             String? @db.VarChar(3)
  sn_motor_prefix         String?
  sn_motor_required       Boolean @default(false)
  sn_motor_unit           String? @db.VarChar(3)
  sn_accessories_prefix   String?
  sn_accessories_required Boolean @default(false)
  sn_accessories_unit     String? @db.VarChar(3)

  bom bomlist @relation(fields: [bom_id], references: [id], onDelete: Cascade)
}

// WM is intentionally provisional. Add typed columns through a migration as WM
// engineering confirms additional components.
model wm_bom_spec {
  bom_id           String  @id @db.Uuid
  sn_prefix        String?
  sn_required      Boolean @default(true)
  sn_drum_prefix   String?
  sn_drum_required Boolean @default(true)
  sn_pump_prefix   String?
  sn_pump_required Boolean @default(false)

  bom bomlist @relation(fields: [bom_id], references: [id], onDelete: Cascade)
}

model ac_registration_spec {
  id_regist      String  @id @db.Uuid
  sn             String?
  sn_odu         String?
  sn_carton      String?
  pcb_idu        String?
  pcb_odu        String?
  sn_box         String?
  sn_motor       String?
  sn_accessories String?

  registration registscan @relation(fields: [id_regist], references: [id], onDelete: Cascade)
}

model wm_registration_spec {
  id_regist String  @id @db.Uuid
  sn        String?
  sn_drum   String?
  sn_pump   String?

  registration registscan @relation(fields: [id_regist], references: [id], onDelete: Cascade)
}

model recordscan_ac {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_regist      String   @db.Uuid
  sn             String?
  sn_odu         String?
  sn_carton      String?
  pcb_idu        String?
  pcb_odu        String?
  sn_box         String?
  sn_motor       String?
  sn_accessories String?
  timestamps     DateTime @default(now()) @db.Timestamptz(6)

  registration registscan @relation(fields: [id_regist], references: [id], onDelete: Cascade)

  @@index([id_regist])
  @@index([sn])
  @@index([sn_odu])
  @@index([sn_carton])
  @@index([pcb_idu])
  @@index([pcb_odu])
  @@index([sn_box])
  @@index([sn_motor])
  @@index([sn_accessories])
  @@index([timestamps])
}

model recordscan_wm {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_regist  String   @db.Uuid
  sn         String?
  sn_drum    String?
  sn_pump    String?
  timestamps DateTime @default(now()) @db.Timestamptz(6)

  registration registscan @relation(fields: [id_regist], references: [id], onDelete: Cascade)

  @@index([id_regist])
  @@index([sn])
  @@index([sn_drum])
  @@index([sn_pump])
  @@index([timestamps])
}

model legacy_component_quarantine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_table String   @db.VarChar(64)
  source_id    String   @db.VarChar(255)
  category     String?  @db.VarChar(50)
  components   Json     @db.JsonB
  reason       String   @db.VarChar(255)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([source_table, source_id])
  @@index([source_table, source_id])
}

// Audit trail perubahan template kategori. Slug tidak memakai FK agar audit
// tetap tersimpan setelah kategori dihapus.
model product_categories_audit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @db.VarChar(50)
  fields     Json?
  changed_by String   @db.VarChar(255)
  changed_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([slug, changed_at])
}
