generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bomlist {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sn_carton        String?   @db.VarChar(255)
  pcb_idu          String?   @db.VarChar(255)
  sn_box           String?   @db.VarChar(255)
  sn_motor         String?   @db.VarChar(255)
  sn_accessories   String?   @db.VarChar(255)
  order_number     String?   @db.VarChar(255)
  sn               String?   @db.VarChar(255)
  timestamps       DateTime? @default(now()) @db.Timestamp(6)
  model            String?   @db.VarChar(255)
  product_category String?   @db.VarChar(50)
  components       Json?     @db.JsonB
  unit_map         Json?     @db.JsonB
  is_active        Boolean   @default(true)
}

model recordscan {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_regist        String?   @db.VarChar(255)
  sn_carton        String?   @db.VarChar(255)
  pcb_idu          String?   @db.VarChar(255)
  sn_box           String?   @db.VarChar(255)
  sn_motor         String?   @db.VarChar(255)
  sn_accessories   String?   @db.VarChar(255)
  sn               String?   @db.VarChar(255)
  sn_odu           String?   @db.VarChar(255)
  timestamps       DateTime? @default(now()) @db.Timestamptz(6)
  product_category String?   @db.VarChar(50)
  components       Json?     @db.JsonB

  @@index([id_regist(ops: raw("gin_trgm_ops"))], map: "idx_recordscan_id_regist_trgm", type: Gin)
  @@index([pcb_idu], map: "idx_recordscan_pcb_idu")
  @@index([sn], map: "idx_recordscan_sn")
  @@index([sn_accessories], map: "idx_recordscan_sn_accessories")
  @@index([sn_box], map: "idx_recordscan_sn_box")
  @@index([sn_carton], map: "idx_recordscan_sn_carton")
  @@index([sn_motor], map: "idx_recordscan_sn_motor")
  @@index([timestamps], map: "idx_recordscan_timestamps")
}

model registscan {
  timestamps       DateTime? @default(now()) @db.Timestamptz(6)
  model            String    @db.VarChar(255)
  order_number     String    @db.VarChar(255)
  subline          String    @db.VarChar(255)
  userid           String    @db.VarChar(255)
  shift            String?   @db.VarChar(255)
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sn               String?   @db.VarChar
  sn_carton        String?   @db.VarChar
  pcb_idu          String?   @db.VarChar
  sn_box           String?   @db.VarChar
  sn_motor         String?   @db.VarChar
  sn_accessories   String?   @db.VarChar
  sn_odu           String?   @db.VarChar
  plan             Int?
  po_number        String?   @db.VarChar(255)
  product_category String?   @db.VarChar(50)
  components       Json?     @db.JsonB
  fields_snapshot  Json?     @db.JsonB
}

model line {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line               String? @db.VarChar(255)
  uph_uph_lineToline uph[]   @relation("uph_lineToline")
}

model model {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand                String?             @db.VarChar(255)
  model                String?             @db.VarChar(255)
  pk                   Decimal?            @db.Decimal
  linkimage            String?             @db.VarChar(255)
  product              String?             @db.VarChar
  category_id          String?             @db.Uuid
  category             product_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  uph_uph_modelTomodel uph[]               @relation("uph_modelTomodel")
}

model uph {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model                  String? @db.Uuid
  line                   String? @db.Uuid
  uph                    Int?
  line_uph_lineToline    line?   @relation("uph_lineToline", fields: [line], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_uph_modelTomodel model?  @relation("uph_modelTomodel", fields: [model], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  username    String  @db.VarChar(255)
  hash        String  @db.VarChar(255)
  password    String? @db.VarChar(255)
  email       String  @db.VarChar(255)
  roleuser    String  @db.VarChar(255)
  departement String  @db.VarChar(255)
  section     String? @db.VarChar(255)
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

model pin {
  id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pin  Int?
  date DateTime? @default(now()) @db.Date
}

model product_categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  fields     Json?    @db.JsonB
  created_at DateTime? @default(now()) @db.Timestamp(6)
  model      model[]
}

// Audit trail perubahan template kategori: siapa mengubah apa kapan.
// slug tanpa FK — baris bertahan walau kategori dihapus.
model product_categories_audit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @db.VarChar(50)
  fields     Json?
  changed_by String   @db.VarChar(255)
  changed_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([slug, changed_at])
}
